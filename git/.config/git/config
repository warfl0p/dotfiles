[alias]
	co = checkout
	br = branch
	ci = commit
	st = status

[credential "https://github.com"]
	helper =
	helper = !mise exec gh -- gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !mise exec gh -- gh auth git-credential
[credential]
	helper = cache --timeout=2592000

[core]
	pager = delta
	sshCommand = ssh -o LogLevel=ERROR

[interactive]
	diffFilter = delta --color-only

[delta]
  dark = true
  # Same add/remove colors as Claude Code's diffs.
  plus-style = syntax "#005f00"
  plus-emph-style = syntax "#008700"
  minus-style = syntax "#5f0000"
  minus-emph-style = syntax "#870000"
  navigate = true
	side-by-side = false
	line-numbers = true
	hyperlinks = true
	file-style = bold yellow
	file-decoration-style = none
	file-modified-label = ""

[status]
	showUntrackedFiles = all

[init]
	defaultBranch = main

[pull]
	rebase = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
