{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm",
          "weekStartDay": "monday"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators",
          "items": [
            "PasswordlessSudo",
            "ScreenRecording",
            "RemoteSession",
            "Reminder",
            "NightLight",
            "StayAwake"
          ]
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "workspaces",
          "type": "qml"
        },
        {
          "id": "omarchy.spacer",
          "size": 10
        },
        {
          "id": "matthias.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "njpatel.omapager"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/cpu-ram-status",
          "id": "cpu-ram",
          "interval": 2,
          "type": "command"
        },
        {
          "id": "matthias.tailscale"
        },
        {
          "id": "matthias.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "matthias.network"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "matthias.audio"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "matthias.media",
    "io.github.sirjul1337.lock-explorer",
    "matthias.osd"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.media",
    "omarchy.lock",
    "omarchy.osd"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "blankMs": 60000,
      "boot": "snapshot:split",
      "design": "split",
      "id": "io.github.sirjul1337.lock-explorer",
      "openAs": "full",
      "reduceMotion": "on"
    },
    {
      "id": "matthias.osd"
    }
  ],
  "version": 1
}
