#!/bin/bash
# Launches apps into their designated Hyprland workspaces.

launch() {
    local workspace="$1"
    local cmd="$2"
    # Hyprland's dispatch IPC now evaluates its argument as Lua (native Lua
    # config support), so the old "[workspace N silent] cmd" bracket-rule
    # prefix no longer parses. Use the Lua exec_cmd rule table instead.
    local escaped_cmd=${cmd//\\/\\\\}
    escaped_cmd=${escaped_cmd//\"/\\\"}
    hyprctl dispatch "hl.dsp.exec_cmd(\"$escaped_cmd\", { workspace = \"$workspace silent\" })"
}

launch 1 "dbeaver"
launch 2 "code"
launch 3 "google-chrome-stable --profile-directory=Default"
launch 4 "/opt/google/chrome/google-chrome --profile-directory=Default --app-id=ompifgpmddkgmclendfeacglnodjjndh"
launch 9 "spotify"
